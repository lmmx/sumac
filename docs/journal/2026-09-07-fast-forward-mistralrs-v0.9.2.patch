+            token: tok,
+            logprob: 0.0,
+            bytes: None,
+            top_logprobs: Some(Vec::new()),
+        };
+        finish_or_add_toks_to_seq(this, prefix_cacher, seq, ff_logprobs, eos_tok, true).await?;
+        if matches!(seq.getstate(), SequenceState::Done(_)) {
+            return Ok(true);
+        }
+    }
+    Ok(false)
