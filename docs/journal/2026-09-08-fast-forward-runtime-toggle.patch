+/// Runtime opt-in for `GeneralMetadata::supports_grammar_fast_forward`, checked once per
+/// process. Off unless `MISTRALRS_GRAMMAR_FAST_FORWARD=1` is set -- see that field's doc
+/// comment for which pipelines this is safe to enable for.
+pub(crate) fn grammar_fast_forward_env_enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var("MISTRALRS_GRAMMAR_FAST_FORWARD").as_deref() == Ok("1"))
+}
